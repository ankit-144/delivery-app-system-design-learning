    {
      "type": "timeseries",
      "title": "JVM heap",
      "description": "Climbing heap that never comes back down after GC = something is accumulating (e.g. the unbounded async notification queue, scenario 6.3).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
