        "y": 22,
        "w": 8,
        "h": 8
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "CPU throttling",
      "description": "Share of 100 ms scheduling periods in which the container wanted more CPU than its quota. Throttling adds latency in 100 ms steps even when average CPU looks fine.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (container) (rate(container_cpu_cfs_throttled_periods_total{container=~\"core-.*\"}[30s])) / sum by (container) (rate(container_cpu_cfs_periods_total{container=~\"core-.*\"}[30s]))",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
