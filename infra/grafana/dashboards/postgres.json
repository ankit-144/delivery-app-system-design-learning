          "type": "tags",
          "tags": [
            "toggle"
          ],
          "matchAny": true,
          "limit": 200
        }
      }
    ]
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "QuickDrop dashboards",
      "type": "dashboards",
      "tags": [
        "quickdrop"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "text",
      "title": "Postgres",
      "options": {
        "mode": "markdown",
        "content": "Every core instance shares this one database. Connections, locks and CPU here are a **shared** budget: adding app instances adds load here (Phase 3), and one slow query hurts everyone. Locks show *contention* (Phase 1); seq scans show *missing indexes* (2.4); idle-in-transaction shows connections held while the app does something else (2.2)."
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "id": 1
    },
    {
      "type": "row",
      "title": "Connections",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Connections by state",
      "description": "'idle in transaction' = a connection inside an open transaction, doing nothing on the DB \u2014 the app is busy elsewhere (calling a vendor?) while holding locks and a pool slot.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (state) (pg_connections_count)",
          "legendFormat": "{{state}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pg_settings_max_connections)",
          "legendFormat": "max_connections",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Active connections by wait type",
      "description": "What running queries are waiting on. 'Lock' = blocked by another transaction's row/table lock; 'none' = actually on CPU; 'IO' = reading from disk; 'Client' = waiting for the app.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (wait_event_type) (pg_connections_count{state=\"active\"})",
          "legendFormat": "{{wait_event_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "id": 4
    },
