          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"quickdrop\"}[30s])",
          "legendFormat": "rollbacks",
          "refId": "B"
