    {
      "type": "timeseries",
      "title": "Where the backlog lives",
      "description": "The same backlog in four different places. Only some of them survive a restart, and only one doesn't load the database.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
