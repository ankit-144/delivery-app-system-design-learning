    {
      "type": "timeseries",
      "title": "Sessions waiting for a lock",
      "description": "Transactions queued behind someone else's lock right now. Row locks show up as ShareLock waits on a transaction id or as tuple locks (scenario 1.1 pessimistic, 2.2 inline-in-tx).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (mode) (pg_lock_waits_waiting)",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 30,
