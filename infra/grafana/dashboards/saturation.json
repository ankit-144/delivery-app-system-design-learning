{
  "uid": "quickdrop-saturation",
  "title": "QuickDrop \u2014 Service saturation",
  "description": "Threads, connection pools, CPU, memory, downstream calls \u2014 where requests wait.",
  "tags": [
    "quickdrop"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
