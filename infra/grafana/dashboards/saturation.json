    {
      "type": "timeseries",
      "title": "Vendor: messages by result",
      "description": "The vendor's view. duplicates = the same messageId arrived twice: a customer got the same SMS twice.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (rate(vendor_messages_total[30s]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(vendor_duplicate_messages_total[30s]))",
          "legendFormat": "duplicates",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
